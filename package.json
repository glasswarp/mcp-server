{
  "name": "@glasswarp/mcp-server",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Remote MCP server — eyes and hands on real Windows PCs via the Glasswarp Platform API",
  "homepage": "https://www.glasswarp.com/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glasswarp/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/glasswarp/mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "windows",
    "computer-use",
    "desktop-automation",
    "glasswarp"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp src/ways-to-run-agents-policy.md dist/ways-to-run-agents-policy.md",
    "start": "node packages/mcp/bin/glasswarp-mcp.js",
    "start:http": "node dist/index.js",
    "start:stdio": "node packages/mcp/bin/glasswarp-mcp.js",
    "test": "node --import tsx --test src/auth.test.ts src/discovery.test.ts src/demos.test.ts src/policy-sync.test.ts src/observe-shape.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "mcp-remote": "^0.1.38",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
